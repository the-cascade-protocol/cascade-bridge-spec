PREFIX earl: <http://www.w3.org/ns/earl#>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>

SELECT DISTINCT ?name ?fault
WHERE {
  ?manifest mf:entries/rdf:rest*/rdf:first ?entry .
  ?entry mf:name ?name .
  OPTIONAL { ?entry bridge:expectedOutcome ?listed }
  OPTIONAL { ?entry bridge:expectedFailedCheck ?check }
  BIND (COALESCE(?listed, earl:passed) AS ?expected)
  OPTIONAL {
    ?assertion earl:test ?test ;
      earl:result ?result .
    FILTER (STRAFTER(STR(?test), "#") = ?name)
    ?result earl:outcome ?outcome .
  }
  BIND (IF(!BOUND(?outcome),
      CONCAT(?name, " has no outcome"),
    IF(?outcome != ?expected,
      CONCAT(?name, " is reported ", STRAFTER(STR(?outcome), STR(earl:)), ", not ", STRAFTER(STR(?expected), STR(earl:))),
    IF(BOUND(?check) && !EXISTS { ?result bridge:failedCheck ?check },
      CONCAT(?name, " is reported failed, but not by ", STRAFTER(STR(?check), "#")),
      ""))) AS ?fault)
  FILTER (?fault != "")
}
ORDER BY ?name ?fault
