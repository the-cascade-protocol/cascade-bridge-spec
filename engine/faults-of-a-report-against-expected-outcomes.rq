PREFIX earl: <http://www.w3.org/ns/earl#>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>

SELECT ?entry ?fault
WHERE {
  {
    FILTER NOT EXISTS { ?anyResult earl:outcome ?anyOutcome }
    BIND ("its report records no outcome" AS ?fault)
  }
  UNION
  {
    {
      SELECT (SAMPLE(?rowEntry) AS ?entry) (IF(MAX(?reported) = 1, "", MAX(?rowFault)) AS ?fault)
      WHERE {
        {
          {
            SELECT ?test (MAX(?key) AS ?bestKey) WHERE {
              {
                ?anyAssertion earl:test ?test ;
                  earl:result/earl:outcome ?anyOutcome .
                BIND ("" AS ?key)
              }
              UNION
              {
                ?anyAssertion earl:test ?test ;
                  earl:result/earl:outcome ?anyOutcome .
                {
                  BIND (9999 AS ?slashes)
                }
                UNION
                {
                  SELECT DISTINCT ?adapter ?slashes WHERE {
                    ?listing bridge:adapter ?adapter ;
                      mf:entries/rdf:rest*/rdf:first ?listedEntry .
                    BIND (STRAFTER(STR(?listedEntry), STR(?adapter)) AS ?within)
                    FILTER (?within != "")
                    BIND (STRLEN(?within) - STRLEN(REPLACE(?within, "/", "")) AS ?slashes)
                  }
                }
                BIND (IF(?slashes = 9999, ?test,
                  IRI(CONCAT(STR(?adapter), REPLACE(STR(?test), CONCAT("^.*/(([^/]*/){", STR(?slashes), "}[^/]*)$"), "$1"))))
                  AS ?candidate)
                FILTER EXISTS { ?entries mf:entries/rdf:rest*/rdf:first ?candidate }
                BIND (CONCAT(SUBSTR("0000", STRLEN(STR(?slashes)) + 1), STR(?slashes), "|", STR(?candidate)) AS ?key)
              }
            }
            GROUP BY ?test
          }
          ?assertion earl:test ?test ;
            earl:result ?result .
          ?result earl:outcome ?outcome .
          BIND (IF(?bestKey = "", ?unmatched, IRI(STRAFTER(?bestKey, "|"))) AS ?listed)
          VALUES ?role { "result" "entry" }
          FILTER (?role = "result" || BOUND(?listed))
        }
        UNION
        {
          ?result earl:outcome ?outcome .
          FILTER NOT EXISTS { ?assertion earl:result ?result ; earl:test ?test }
          BIND ("result" AS ?role)
        }
        UNION
        {
          ?listing mf:entries/rdf:rest*/rdf:first ?listed .
          BIND ("entry" AS ?role)
        }
        OPTIONAL {
          ?mustFail bridge:expectedFailedCheck ?check .
          FILTER (sameTerm(?mustFail, ?listed))
        }
        BIND (COALESCE(
            IF(CONTAINS(STR(?listed), "#"), STRAFTER(STR(?listed), "#"), STR(?listed)),
            IF(CONTAINS(STR(?test), "#"), STRAFTER(STR(?test), "#"), STR(?test)),
            "a result naming no test") AS ?name)
        BIND (STRAFTER(STR(?outcome), STR(earl:)) AS ?word)
        BIND (IF(isLITERAL(?outcome), CONCAT("\"", STR(?outcome), "\""),
          IF(isBLANK(?outcome), "a blank node",
            IF(STRSTARTS(STR(?outcome), STR(earl:)), ?word, CONCAT("<", STR(?outcome), ">")))) AS ?given)
        BIND (IF(?role = "entry", IF(BOUND(?result), 1, 0), 0) AS ?reported)
        BIND (?outcome IN (earl:passed, earl:failed, earl:cantTell, earl:inapplicable, earl:untested) AS ?ofEarl)
        BIND (BOUND(?listed) && EXISTS { ?listed a bridge:InputOnlyTest } && ?outcome IN (earl:passed, earl:untested)
          AS ?inputOnlyNotCantTell)
        BIND (IF(?role = "entry",
            CONCAT(?name, " has no outcome"),
          IF(!?ofEarl,
            CONCAT(?name, " is reported ", ?given, ", and ", ?given, " is not one of EARL's five outcomes"),
          IF(BOUND(?check),
            IF(sameTerm(?outcome, earl:failed),
              IF(EXISTS { ?result bridge:failedCheck ?check }, "",
                CONCAT(?name, " is reported failed, but not by ",
                  IF(CONTAINS(STR(?check), "#"), STRAFTER(STR(?check), "#"), STR(?check)))),
              CONCAT(?name, " is reported ", ?word, ", not failed")),
          IF(?outcome IN (earl:failed, earl:inapplicable),
            CONCAT(?name, " is reported ", ?word, ": a report that holds gives only passed, cantTell or untested"),
          IF(?inputOnlyNotCantTell,
            CONCAT("input-only ", ?name, " is reported ", ?word, ", not cantTell"),
            ""))))) AS ?rowFault)
        BIND (IF(?role = "entry" || (?ofEarl && (BOUND(?check) || ?inputOnlyNotCantTell)), ?listed, ?test) AS ?rowEntry)
        BIND (IF(?role = "entry", ?listed, ?unmatched) AS ?groupEntry)
        BIND (IF(?role = "result", ?result, ?unmatched) AS ?groupResult)
        BIND (IF(?role = "result", ?outcome, ?unmatched) AS ?groupOutcome)
      }
      GROUP BY ?role ?groupEntry ?groupResult ?groupOutcome
    }
    FILTER (?fault != "")
    FILTER EXISTS { ?anyResult earl:outcome ?anyOutcome }
  }
}
ORDER BY ?entry ?fault
