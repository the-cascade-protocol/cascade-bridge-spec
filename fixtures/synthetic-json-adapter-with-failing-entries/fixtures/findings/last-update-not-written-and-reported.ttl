@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix ex:      <https://example.org/synthetic-adapter/v1#> .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/last-update-not-written-and-reported.json> ;
    oa:hasSelector [
      a oa:FragmentSelector ;
      dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
      rdf:value "" ;
      oa:refinedBy [ a oa:FragmentSelector ; dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ; rdf:value "/lastUpdated" ]
    ]
  ] ;
  oa:hasBody ex:a-last-update-with-no-time-zone ;
  oa:motivatedBy oa:classifying ;
  sh:value "2026-07-15" ;
  sh:resultSeverity sh:Warning .
