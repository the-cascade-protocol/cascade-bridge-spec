  ] .

<#nearer-label-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "nearer-label-not-written" ;
  rdfs:comment "Two records outside every contained record, one standing inside the other's address: the label of the nearer is not written, and the farther record has a label." ;
