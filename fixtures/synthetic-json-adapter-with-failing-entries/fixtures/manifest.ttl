  ] ;
  mf:result [
    bridge:expectedGraph <expected/unmapped-contained-label-unreported.ttl> ;
    bridge:expectedFindings <findings/unmapped-contained-label-unreported.ttl>
  ] .

<#contained-label-reported-named-gap> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-reported-named-gap" ;
  rdfs:comment "The label of a contained record not written, with a finding addressed at the contained record whose body is the gap the path's entry names." ;
  mf:action [
    bridge:input <in/contained-label-reported-named-gap.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
