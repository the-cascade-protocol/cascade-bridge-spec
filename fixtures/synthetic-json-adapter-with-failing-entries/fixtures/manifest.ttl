@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "synthetic JSON adapter whose mapping writes only a record's accession and version" ;
  bridge:adapter <../> ;
  mf:entries (
    <#every-carried-path-written>
    <#label-not-written>
    <#label-not-written-and-reported>
    <#label-empty>
    <#label-holding-only-markup>
    <#label-empty-beside-a-caption>
    <#last-update-not-written-reported>
    <#last-update-not-written>
    <#contained-label-not-written>
    <#unmapped-contained-label-unreported>
    <#contained-label-reported-named-gap>
    <#contained-label-reported-other-gap>
    <#contained-label-sibling-reported>
    <#nearer-label-not-written>
    <#nearer-label-written>
    <#contained-record-held-back-whole>
    <#label-white-space-only>
    <#label-markup-with-an-attribute>
    <#label-null>
    <#label-empty-object>
    <#label-empty-array>
    <#label-false-not-written>
    <#empty-label-beside-last-update>
    <#caption-repeat-empty-beside-full>
    <#unmapped-contained-label-reported>
    <#contained-label-held-back-whole>
    <#held-back-note-beside-label>
    <#related-label-held-back-whole>
    <#related-label-unmapped-value-gap>
    <#respelled-selector-label-unwritten>
    <#respelled-selector-title-written>
    <#selector-selects-no-node>
    <#aside-of-a-class-no-record-has>
    <#remark-of-two-classes-one-held>
    <#label-written-on-the-version>
    <#label-written-on-the-arrival>
    <#label-written-on-a-pointed-node>
    <#label-written-on-a-pointed-record>
    <#label-finding-below-the-value>
    <#label-finding-at-the-unit>
    <#last-update-reported-at-the-unit>
    <#label-finding-by-value-only>
    <#finding-of-the-other-unit>
    <#contained-status-lookup-gap>
    <#tied-records-label-on-one>
    <#label-zero-not-written>
    <#null-and-array-no-empty-child>
    <#label-written-only-as-empty>
    <#empty-label-written-as-empty>
    <#label-written-as-a-node-of-nothing>
    <#record-holding-it-is-nearer>
    <#record-below-an-element-held-back>
    <#selector-outside-the-unit>
  ) .

<#every-carried-path-written> a bridge:IsomorphicConversionTest ;
  mf:name "every-carried-path-written" ;
  mf:action [
    bridge:input <in/every-carried-path-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/every-carried-path-written.ttl> ;
    bridge:expectedFindings <findings/every-carried-path-written.ttl>
  ] .

<#label-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "label-not-written" ;
  rdfs:comment "A carried path holding a value the mapping does not write, and no finding about it." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/label-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-not-written.ttl> ;
    bridge:expectedFindings <findings/label-not-written.ttl>
  ] .

<#label-not-written-and-reported> a bridge:IsomorphicConversionTest ;
  mf:name "label-not-written-and-reported" ;
  rdfs:comment "The path of label-not-written not written, with a finding addressed at it." ;
  mf:action [
    bridge:input <in/label-not-written-and-reported.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-not-written-and-reported.ttl> ;
    bridge:expectedFindings <findings/label-not-written-and-reported.ttl>
  ] .

<#label-empty> a bridge:IsomorphicConversionTest ;
  mf:name "label-empty" ;
  rdfs:comment "The path of label-not-written holding an empty string: nothing is owed." ;
  mf:action [
    bridge:input <in/label-empty.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-empty.ttl> ;
    bridge:expectedFindings <findings/label-empty.ttl>
  ] .

<#label-holding-only-markup> a bridge:IsomorphicConversionTest ;
  mf:name "label-holding-only-markup" ;
  rdfs:comment "The path of label-not-written holding a string of XHTML elements with no text in them: nothing is owed." ;
  mf:action [
    bridge:input <in/label-holding-only-markup.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-holding-only-markup.ttl> ;
    bridge:expectedFindings <findings/label-holding-only-markup.ttl>
  ] .

<#label-empty-beside-a-caption> a bridge:IsomorphicConversionTest ;
  mf:name "label-empty-beside-a-caption" ;
  rdfs:comment "Two children of one element carried as rdfs:label, the label empty and the caption not written: the caption is not owed." ;
  mf:action [
    bridge:input <in/label-empty-beside-a-caption.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-empty-beside-a-caption.ttl> ;
    bridge:expectedFindings <findings/label-empty-beside-a-caption.ttl>
  ] .

<#last-update-not-written-reported> a bridge:IsomorphicConversionTest ;
  mf:name "last-update-not-written-reported" ;
  rdfs:comment "A path carried in part, not written, with a finding whose body is the gap its accounting entry names." ;
  mf:action [
    bridge:input <in/last-update-not-written-reported.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/last-update-not-written-reported.ttl> ;
    bridge:expectedFindings <findings/last-update-not-written-reported.ttl>
  ] .

<#last-update-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "last-update-not-written" ;
  rdfs:comment "A path carried in part, not written, and no finding about it." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/last-update-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/last-update-not-written.ttl> ;
    bridge:expectedFindings <findings/last-update-not-written.ttl>
  ] .

<#contained-label-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-not-written" ;
  rdfs:comment "One unit holding two contained members, one a record the mapping writes and one it does not: both hold the label, which is owed for both, the first to the record the mapping writes and the second to the container's, and the mapping writes it for neither." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/contained-label-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-not-written.ttl> ;
    bridge:expectedFindings <findings/contained-label-not-written.ttl>
  ] .

<#unmapped-contained-label-unreported> a bridge:IsomorphicConversionTest ;
  mf:name "unmapped-contained-label-unreported" ;
  rdfs:comment "A contained member no record is written from holds the label, which belongs to the container's record, and nothing reports it." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/unmapped-contained-label-unreported.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
