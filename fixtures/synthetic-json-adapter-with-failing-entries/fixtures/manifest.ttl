<#contained-label-sibling-reported> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-sibling-reported" ;
  rdfs:comment "Two contained records, neither label written: the first is reported by the gap the path's entry names, and the second is reported by nothing." ;
