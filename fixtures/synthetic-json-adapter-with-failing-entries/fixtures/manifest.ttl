  ] .

<#contained-record-held-back-whole> a bridge:IsomorphicConversionTest ;
  mf:name "contained-record-held-back-whole" ;
  rdfs:comment "A record written from a contained member reported as held back whole: the finding is contradicted by the record, and the label is still owed." ;
