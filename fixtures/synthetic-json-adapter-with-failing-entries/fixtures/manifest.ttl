@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "synthetic JSON adapter whose mapping writes only a record's accession and version" ;
  bridge:adapter <../> ;
  mf:entries (
    <#every-carried-path-written>
    <#label-not-written>
    <#label-not-written-and-reported>
    <#label-empty>
    <#last-update-not-written-and-reported>
    <#last-update-not-written>
    <#contained-label-not-written>
    <#contained-label-of-a-record-the-adapter-does-not-map>
    <#label-holding-only-markup>
    <#label-empty-beside-a-caption>
    <#contained-label-reported-by-the-gap-the-entry-names>
    <#contained-label-reported-by-a-gap-the-entry-does-not-name>
    <#contained-label-reported-on-a-sibling-contained-record>
    <#label-of-the-nearer-record-not-written>
    <#label-of-the-nearer-record-written>
    <#contained-label-in-an-element-not-carried-at-all>
    <#contained-label-in-an-element-reported-by-a-value-gap>
  ) .

<#contained-label-in-an-element-not-carried-at-all> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-in-an-element-not-carried-at-all" ;
  rdfs:comment "The label of a contained record not written, with a finding addressed at the contained record whose body is a gap of bridge:elementNotCarried: nothing in the record is owed, the path's entry naming another gap." ;
  mf:action [
    bridge:input <in/contained-label-in-an-element-not-carried-at-all.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-in-an-element-not-carried-at-all.ttl> ;
    bridge:expectedFindings <findings/contained-label-in-an-element-not-carried-at-all.ttl>
  ] .

<#contained-label-in-an-element-reported-by-a-value-gap> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-in-an-element-reported-by-a-value-gap" ;
  rdfs:comment "The unit of contained-label-in-an-element-not-carried-at-all with the finding's body a gap of bridge:valueNotMapped that the path's entry does not name: it drops nothing below the record, so the label is still owed." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/contained-label-in-an-element-reported-by-a-value-gap.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-in-an-element-reported-by-a-value-gap.ttl> ;
    bridge:expectedFindings <findings/contained-label-in-an-element-reported-by-a-value-gap.ttl>
  ] .

<#every-carried-path-written> a bridge:IsomorphicConversionTest ;
  mf:name "every-carried-path-written" ;
  mf:action [
    bridge:input <in/every-carried-path-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/every-carried-path-written.ttl> ;
    bridge:expectedFindings <findings/every-carried-path-written.ttl>
  ] .

<#label-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "label-not-written" ;
  rdfs:comment "A carried path holding a value the mapping does not write, and no finding about it." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/label-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-not-written.ttl> ;
    bridge:expectedFindings <findings/label-not-written.ttl>
  ] .

<#label-not-written-and-reported> a bridge:IsomorphicConversionTest ;
  mf:name "label-not-written-and-reported" ;
  rdfs:comment "The path of label-not-written not written, with a finding addressed at it." ;
  mf:action [
    bridge:input <in/label-not-written-and-reported.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-not-written-and-reported.ttl> ;
    bridge:expectedFindings <findings/label-not-written-and-reported.ttl>
  ] .

<#label-empty> a bridge:IsomorphicConversionTest ;
  mf:name "label-empty" ;
  rdfs:comment "The path of label-not-written holding an empty string: nothing is owed." ;
  mf:action [
    bridge:input <in/label-empty.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-empty.ttl> ;
    bridge:expectedFindings <findings/label-empty.ttl>
  ] .

<#last-update-not-written-and-reported> a bridge:IsomorphicConversionTest ;
  mf:name "last-update-not-written-and-reported" ;
  rdfs:comment "A path carried in part, not written, with a finding whose body is the gap its accounting entry names." ;
  mf:action [
    bridge:input <in/last-update-not-written-and-reported.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/last-update-not-written-and-reported.ttl> ;
    bridge:expectedFindings <findings/last-update-not-written-and-reported.ttl>
  ] .

<#last-update-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "last-update-not-written" ;
  rdfs:comment "A path carried in part, not written, and no finding about it: the entry's gap is for the values it does not carry, and this one is not reported." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/last-update-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/last-update-not-written.ttl> ;
    bridge:expectedFindings <findings/last-update-not-written.ttl>
  ] .

<#contained-label-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-not-written" ;
  rdfs:comment "One unit holding three source records, one a contained record the mapping writes a record from and one a contained record it does not: both hold the label, the path is owed for the first only, and the mapping does not write it." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/contained-label-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-not-written.ttl> ;
    bridge:expectedFindings <findings/contained-label-not-written.ttl>
  ] .

<#contained-label-of-a-record-the-adapter-does-not-map> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-of-a-record-the-adapter-does-not-map" ;
  rdfs:comment "The unit of contained-label-not-written without the label of the contained record the mapping writes a record from: the label of the one it does not is owed to no record, the container's included." ;
  mf:action [
    bridge:input <in/contained-label-of-a-record-the-adapter-does-not-map.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-of-a-record-the-adapter-does-not-map.ttl> ;
    bridge:expectedFindings <findings/contained-label-of-a-record-the-adapter-does-not-map.ttl>
  ] .

<#label-holding-only-markup> a bridge:IsomorphicConversionTest ;
  mf:name "label-holding-only-markup" ;
  rdfs:comment "The path of label-not-written holding a string of XHTML elements with no text in them: nothing is owed." ;
  mf:action [
    bridge:input <in/label-holding-only-markup.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-holding-only-markup.ttl> ;
    bridge:expectedFindings <findings/label-holding-only-markup.ttl>
  ] .

<#label-empty-beside-a-caption> a bridge:IsomorphicConversionTest ;
  mf:name "label-empty-beside-a-caption" ;
  rdfs:comment "Two members of one element carried as rdfs:label, the label empty and the caption not written: the caption is not owed." ;
  mf:action [
    bridge:input <in/label-empty-beside-a-caption.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-empty-beside-a-caption.ttl> ;
    bridge:expectedFindings <findings/label-empty-beside-a-caption.ttl>
  ] .

<#contained-label-reported-by-the-gap-the-entry-names> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-reported-by-the-gap-the-entry-names" ;
  rdfs:comment "The label of a contained record not written, with a finding addressed at the contained record whose body is the gap the path's entry names." ;
  mf:action [
    bridge:input <in/contained-label-reported-by-the-gap-the-entry-names.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-reported-by-the-gap-the-entry-names.ttl> ;
    bridge:expectedFindings <findings/contained-label-reported-by-the-gap-the-entry-names.ttl>
  ] .

<#contained-label-reported-by-a-gap-the-entry-does-not-name> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-reported-by-a-gap-the-entry-does-not-name" ;
  rdfs:comment "The label of a contained record not written, with a finding addressed at the contained record whose body is another gap than the path's entry names." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/contained-label-reported-by-a-gap-the-entry-does-not-name.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-reported-by-a-gap-the-entry-does-not-name.ttl> ;
    bridge:expectedFindings <findings/contained-label-reported-by-a-gap-the-entry-does-not-name.ttl>
  ] .

<#contained-label-reported-on-a-sibling-contained-record> a bridge:IsomorphicConversionTest ;
  mf:name "contained-label-reported-on-a-sibling-contained-record" ;
  rdfs:comment "Two contained records, neither label written: the first is reported by the gap the path's entry names, and the second is reported by nothing." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/contained-label-reported-on-a-sibling-contained-record.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/contained-label-reported-on-a-sibling-contained-record.ttl> ;
    bridge:expectedFindings <findings/contained-label-reported-on-a-sibling-contained-record.ttl>
  ] .

<#label-of-the-nearer-record-not-written> a bridge:IsomorphicConversionTest ;
  mf:name "label-of-the-nearer-record-not-written" ;
  rdfs:comment "Two records outside every contained record, one standing inside the other's address: the label of the nearer is not written, and the farther record has a label." ;
  bridge:expectedFailedCheck bridge:conversionWritesWhatTheAccountingCarries ;
  mf:action [
    bridge:input <in/label-of-the-nearer-record-not-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-of-the-nearer-record-not-written.ttl> ;
    bridge:expectedFindings <findings/label-of-the-nearer-record-not-written.ttl>
  ] .

<#label-of-the-nearer-record-written> a bridge:IsomorphicConversionTest ;
  mf:name "label-of-the-nearer-record-written" ;
  rdfs:comment "The unit of label-of-the-nearer-record-not-written with the nearer record's label written." ;
  mf:action [
    bridge:input <in/label-of-the-nearer-record-written.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record> ;
    bridge:facts <facts/example-registry.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/label-of-the-nearer-record-written.ttl> ;
    bridge:expectedFindings <findings/label-of-the-nearer-record-written.ttl>
  ] .
