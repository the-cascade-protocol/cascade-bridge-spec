PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ex:      <https://example.org/synthetic-adapter/v1#>

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [
        a oa:FragmentSelector ;
        dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
        rdf:value ?pointer
      ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?written ;
    sh:resultSeverity ?severity .
}
WHERE {
  ?record a fx:root .
  {
    ?record xyz:label ?written .
    FILTER(?written = "[redacted]")
    BIND("/label" AS ?pointer)
    BIND(ex:a-label-the-source-withheld AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:label ?label .
    ?label xyz:text ?written .
    FILTER(?written = "[redacted]")
    BIND("/label/text" AS ?pointer)
    BIND(ex:a-label-the-source-withheld AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:label ?written .
    FILTER(?written = "[unaddressed]")
    BIND("" AS ?pointer)
    BIND(ex:a-label-the-source-withheld AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:label ?label .
    FILTER(?label = "[by-value]")
    BIND("/label" AS ?written)
    BIND("/accession" AS ?pointer)
    BIND(ex:a-label-the-source-withheld AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:related ?related .
    ?related xyz:label ?written .
    FILTER(?written = "[dropped]")
    BIND("/related" AS ?pointer)
    BIND(ex:a-related-record-of-which-nothing-is-carried AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:related ?related .
    ?related xyz:label ?written .
    FILTER(?written = "[unmapped]")
    BIND("/related" AS ?pointer)
    BIND(ex:a-related-value-the-source-could-not-map AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:contained ?contained .
    ?contained ?slot ?item .
    ?item xyz:label ?written .
    FILTER(?written = "[withheld]")
    BIND(CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?pointer)
    BIND(ex:a-contained-label-the-source-withheld AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:contained ?contained .
    ?contained ?slot ?item .
    ?item xyz:label ?written .
    FILTER(?written = "[redacted]")
    BIND(CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?pointer)
    BIND(ex:a-label-the-source-withheld AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:contained ?contained .
    ?contained ?slot ?item .
    ?item xyz:label ?written .
    FILTER(?written = "[dropped]")
    BIND(CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?pointer)
    BIND(ex:a-contained-record-the-source-held-back-whole AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:contained ?contained .
    ?contained ?slot ?item .
    ?item xyz:note ?written .
    FILTER(?written = "[dropped]")
    BIND(CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1), "/note") AS ?pointer)
    BIND(ex:a-contained-record-the-source-held-back-whole AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:contained ?contained .
    ?contained ?slot ?item .
    ?item xyz:label ?written .
    FILTER(?written = "[unmapped]")
    BIND(CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?pointer)
    BIND(ex:a-contained-value-the-source-could-not-map AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:contained ?contained .
    ?contained ?slot ?item .
    ?item xyz:status ?written .
    FILTER(?written = "withdrawn")
    BIND(CONCAT("/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?pointer)
    BIND(ex:a-contained-value-the-source-could-not-map AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:lastUpdated ?written .
    FILTER(?written = "2026-07-16")
    BIND("" AS ?pointer)
    BIND(ex:a-last-update-with-no-time-zone AS ?gap)
    BIND(sh:Warning AS ?severity)
  }
  UNION
  {
    ?record xyz:lastUpdated ?written .
    FILTER(?written != "2026-07-16" && !REGEX(?written, "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|[+-]((0[0-9]|1[0-3]):[0-5][0-9]|14:00))$"))
    BIND("/lastUpdated" AS ?pointer)
    BIND(ex:a-last-update-with-no-time-zone AS ?gap)
    BIND(sh:Warning AS ?severity)
  }
  UNION
  {
    ?record xyz:lastUpdated ?written .
    FILTER NOT EXISTS { ?record xyz:version ?number }
    FILTER(?written != "2026-07-17")
    BIND("/lastUpdated" AS ?pointer)
    BIND(ex:a-last-update-of-a-record-no-mapping-reads AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  UNION
  {
    ?record xyz:phone ?phones .
    ?phones ?slot ?written .
    FILTER(STRSTARTS(STR(?slot), STR(rdf:_)) && ?written != "[unreported]")
    BIND(CONCAT("/phone/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?pointer)
    BIND(ex:a-phone-number-no-predicate-carries AS ?gap)
    BIND(sh:Info AS ?severity)
  }
}
