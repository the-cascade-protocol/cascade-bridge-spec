@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix ex:     <https://example.org/synthetic-adapter/v1#> .

ex:gaps a skos:ConceptScheme .

ex:a-label-the-source-withheld a skos:Concept ;
  skos:prefLabel "a label the source withheld" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:carriedWithLoss .

ex:a-contained-label-the-source-withheld a skos:Concept ;
  skos:prefLabel "a label of a contained record the source withheld" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:carriedWithLoss .

ex:a-contained-record-the-source-held-back-whole a skos:Concept ;
  skos:prefLabel "a contained record of which nothing is carried" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:elementNotCarried .

ex:a-related-record-of-which-nothing-is-carried a skos:Concept ;
  skos:prefLabel "a related record of which nothing is carried" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:elementNotCarried .

ex:a-related-value-the-source-could-not-map a skos:Concept ;
  skos:prefLabel "a value of a related record outside the set the vocabulary fixes" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:valueNotMapped .

ex:a-contained-value-the-source-could-not-map a skos:Concept ;
  skos:prefLabel "a value of a contained record outside the set the vocabulary fixes" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:valueNotMapped .

ex:a-last-update-with-no-time-zone a skos:Concept ;
  skos:prefLabel "a last update stated with no time or no time zone" ;
  skos:inScheme ex:gaps ;
  skos:broader bridge:carriedWithLoss ;
  sh:resultSeverity sh:Warning .
